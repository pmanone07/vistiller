# Supabase-prosjektet (Project Settings → API / API Keys)
# De klassiske navnene NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY /
# SUPABASE_ANON_KEY og SUPABASE_SERVICE_ROLE_KEY godtas fortsatt.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_…) – trygg å eksponere i nettleseren.
# Kan også hete NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_…) – KUN på serveren. Brukes til de kontrollerte
# offentlige påmeldingsfunksjonene. Må aldri eksponeres i klientkode, og skal
# aldri ha NEXT_PUBLIC_-prefiks.
SUPABASE_SECRET_KEY=

# Offentlig adresse, brukes i delingslenker, QR-koder og e-postlenker
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hemmelig salt for hashing av IP-adresser (rate limiting) – KUN på serveren.
# Anbefales i produksjon. Står den tom, brukes SUPABASE_SECRET_KEY (eller
# SUPABASE_SERVICE_ROLE_KEY) som salt. Uten noen av disse feiler påmeldingen
# med en tydelig feilmelding i stedet for å bruke et kjent salt.
IP_HASH_SALT=
# Valgfritt: tillatte origins for /api/v1 (f.eks. en fremtidig Capacitor-app)
# API_ALLOWED_ORIGINS=capacitor://localhost,https://localhost
